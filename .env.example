# ==========================================
# PredictPlay Environment Variables
# ==========================================

# --- Gemini AI Configuration ---
# Required for Gemini AI vision & OCR screenshot analysis
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""

# --- Application URL ---
# Base URL for the app (used for callbacks, metadata, etc.)
APP_URL="http://localhost:3000"

# --- Firebase Client SDK (Public) ---
# Found in: Firebase Console → Project Settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="predictplay-10230.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="predictplay-10230"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="predictplay-10230.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# --- Firebase Admin SDK (Server-side) ---
# Download service account key from:
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID="predictplay-10230"
FIREBASE_STORAGE_BUCKET="predictplay-10230.firebasestorage.app"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-fbsvc@predictplay-10230.iam.gserviceaccount.com"
# Private key with literal \n escapes or wrapped in quotes
FIREBASE_PRIVATE_KEY=""

