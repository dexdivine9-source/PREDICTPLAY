rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update: if request.auth != null && request.auth.uid == resource.data.uid;
      allow delete: if false;
    }

    match /player_profiles/{profileId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false; // Only server can update reputation securely
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.creatorId == request.auth.uid
                    && request.resource.data.state == 'OPEN'
                    && request.resource.data.player1Id == request.auth.uid
                    && (!('player2Id' in request.resource.data) || request.resource.data.player2Id == null);
      
      allow update: if request.auth != null 
                    && (
                      (resource.data.state == 'OPEN' && request.resource.data.state == 'PLAYER_JOINED' && request.resource.data.player2Id == request.auth.uid && resource.data.creatorId != request.auth.uid)
                      || (resource.data.creatorId == request.auth.uid && resource.data.state != 'COMPLETED')
                      || (resource.data.player2Id == request.auth.uid && resource.data.state != 'COMPLETED')
                    );
                    
      allow delete: if false;
    }

    match /match_participants/{participantId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }
    match /virtual_wallets/{walletId} {
      allow read: if true;
      allow write: if false;
    }

    match /markets/{marketId} {
      allow read: if true;
      allow write: if false;
    }

    match /predictions/{predId} {
      allow read: if true;
      allow write: if false;
    }

    match /transactions/{txId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
